  dialog.addEventListener("click",function(e){if(e.target===dialog)closeSearch();});
  document.addEventListener("keydown",function(e){
    if((e.metaKey||e.ctrlKey)&&e.key.toLowerCase()==="k"){e.preventDefault();if(!dialog.open)openSearch();else input.focus();}
    if(e.key==="Escape"){if(side.classList.contains("is-open"))closeDrawer(true);closePrefs();}
  });

  /* Progress, current chapter and visible table-of-contents location. */
  var tocLinks=Array.from(document.querySelectorAll('nav.side a[href^="#"]'));
  var linkById={};tocLinks.forEach(function(a){linkById[a.hash.slice(1)]=a;});
  var back=$("backToTop"), running=false;
  function updatePosition(){
    running=false;
    var doc=document.documentElement;
    var max=Math.max(1,doc.scrollHeight-window.innerHeight);
    var pct=Math.min(100,Math.max(0,window.scrollY/max*100));
    $("readingProgressBar").style.width=pct.toFixed(2)+"%";
    back.hidden=window.scrollY<700;
    var active=null;
    for(var i=0;i<sections.length;i++){
      if(sections[i].getBoundingClientRect().top<=150)active=sections[i];else break;
    }
    if(active){
      tocLinks.forEach(function(a){var yes=a===linkById[active.id];a.classList.toggle("active",yes);
        if(yes)a.setAttribute("aria-current","location");else a.removeAttribute("aria-current");});
      var heading=active.querySelector("h2");$("currentChapter").textContent=heading?heading.textContent.trim():"Luật TMQT";
    }else $("currentChapter").textContent="Giới thiệu";
  }
  function queuePosition(){if(!running){running=true;requestAnimationFrame(updatePosition);}}
  window.addEventListener("scroll",queuePosition,{passive:true});
  window.addEventListener("resize",queuePosition,{passive:true});
  window.addEventListener("load",queuePosition);
  back.addEventListener("click",function(){window.scrollTo({top:0,behavior:window.matchMedia("(prefers-reduced-motion: reduce)").matches?"auto":"smooth"});});
  window.addEventListener("beforeprint",function(){document.querySelectorAll("main details").forEach(function(d){d.open=true;});});
  updatePosition();
})();
</script>
</body>
</html>
